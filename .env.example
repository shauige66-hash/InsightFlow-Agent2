# InsightFlow-Agent2 运行配置示例。
#
# 复制为 .env 后按需修改；.env 不进版本库。
# 不填写存储配置时使用本地模式：SQLite RunStore + 进程内知识索引，
# 无需 PostgreSQL 或 Redis。

# --- 模型网关 ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
CLIENT_APP=insightflow-agent2

# --- 存储模式 ---
# local    : SQLite RunStore + 进程内知识索引（默认，轻量单机）
# postgres : PostgreSQL 保存会话/记忆/知识索引，RunStatus 与 Checkpoint 也走 PostgreSQL
INSIGHTFLOW_STORAGE=local
INSIGHTFLOW_DATABASE_URL=postgresql+psycopg://insightflow:insightflow@127.0.0.1:5433/insightflow

# 数据库连接池上限（postgres 模式）
INSIGHTFLOW_DB_POOL_SIZE=5

# --- Redis 缓存 ---
# 只用于 RAG 查询与检索结果缓存；不是会话、记忆或 Checkpoint 的权威存储。
INSIGHTFLOW_REDIS_ENABLED=false
INSIGHTFLOW_REDIS_URL=redis://127.0.0.1:6380/0
INSIGHTFLOW_REDIS_TTL_SECONDS=600

# --- 会话归属 ---
# 不设 INSIGHTFLOW_API_KEYS 时是本地单用户演示模式：所有数据归这一个 owner。
INSIGHTFLOW_OWNER=local-demo

# --- 接口鉴权（可选） ---
# 设置后所有接口（健康检查、控制台页面、报告读取除外）都必须带
# `Authorization: Bearer <token>`；归属者由 token 推导，不接受请求体自报。
# 格式 token:owner,token2:owner2 —— 写错会直接启动失败，而不是静默放行。
INSIGHTFLOW_API_KEYS=

# --- 飞书群机器人（可选） ---
# 只做单向推送：Run 完成 / 失败 / 需要人工确认时往群里发一张卡片。
# 留空即关闭，不影响任何既有行为；推送失败只会记日志，不会让 Run 失败。
# 获取方式：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址。
# 若创建时勾选了"签名校验"，把密钥填到 FEISHU_SIGN_SECRET。
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=
# 可选：卡片里附一个"打开控制台"链接。127.0.0.1 只在跑服务这台机器上有效，
# 自用时填 http://127.0.0.1:8123/ui/ ；分享到别人的群则留空。
FEISHU_CONSOLE_URL=

# --- docker compose 本地服务 ---
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=insightflow
POSTGRES_DB=insightflow
POSTGRES_PORT=5433
REDIS_PORT=6380
